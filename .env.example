# Copy to .env.development or .env.production and fill in values.
# Never commit real secrets.

NODE_ENV=development

# TCP server
TCP_HOST=0.0.0.0
TCP_PORT=5027

# MongoDB Atlas (same DB as IoT Dashboard)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority

# Logging: fatal | error | warn | info | debug
LOG_LEVEL=debug

# strict = IMEI must exist in Devices collection
# open   = accept any valid IMEI format (lab only)
IMEI_AUTH_MODE=strict

# Idle socket timeout (ms)
SOCKET_IDLE_TIMEOUT_MS=300000

# Max bytes buffered per connection (memory protection)
MAX_BUFFER_BYTES=1048576
